    {
      "type": "paragraphe",
      "texte": "1) Calculons la longueur développée du mur de soubassement :"
    },
    {
      "type": "calcul",
      "lignes": [
        "LdT = LdH + LdV + Larc",
        "LdH = 1,45 + 1,45 + 1,45 + 2,95 + 1,975 = 9,275 m",
        "LdV = 2,6 + 2,6 + 1,825 = 7,025 m",
        "Larc = (2 * π * R) / 4 = (2 * π * 1,075) / 4 = 1,69 m",
        "LdT = LdH + LdV + Larc",
        "= 9,275 + 7,025 + 1,69",
        "LdT = 18 m."
      ]
    },
    {
      "type": "paragraphe",
