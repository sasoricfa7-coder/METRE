{
  "contenu": [
    {
      "type": "calcul",
      "lignes": [
        "V = Ldt x l x h"
      ]
    },
    {
      "type": "paragraphe",
      "texte": "Ldt : longueur développée totale des fouilles."
    },
    {
      "type": "paragraphe",
      "texte": "l : largeur de remblai"
    },
    {
      "type": "paragraphe",
      "texte": "h : hauteur de remblai"
    },
    {
      "type": "paragraphe",
      "texte": "• Pour les remblais d'apport intérieur, il se calcule de la manière suivante :"
    },
    {
      "type": "calcul",
      "lignes": [
        "V = L x l x h"
      ]
    },
    {
      "type": "paragraphe",
      "texte": "L : longueur intérieure de la pièce"
    },
    {
      "type": "paragraphe",
      "texte": "l : largeur intérieure de la pièce"
    },
    {
      "type": "paragraphe",
      "texte": "h : hauteur de remblai"
    },
    {
      "type": "paragraphe",
      "texte": "• Pour les semelles isolées, il se calcule de la façon suivante :"
    },
    {
      "type": "calcul",
      "lignes": [
        "V = ((L x l) - (Section poteau)) x h x n avec"
      ]
    },
    {
      "type": "paragraphe",
      "texte": "L : longueur de la fouille en semelle isolée"
    },
    {
      "type": "paragraphe",
      "texte": "l : largeur de la fouille en semelle isolée"
    },
    {
      "type": "paragraphe",
      "texte": "h : hauteur du remblai"
    },
    {
      "type": "paragraphe",
      "texte": "n : nombre de fouilles de semelle isolée"
    },
    {
      "type": "titre",
      "texte": "Exercice d'application"
    },
